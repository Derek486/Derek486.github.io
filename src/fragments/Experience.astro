---
import ExperienceItem from "@/components/ExperienceItem.astro"
import type { IExperience } from "@/shared/types"
import { TAGS } from "@/shared/values"

const EXPERIENCE: IExperience[] = [
  {
    date: "Abr. 2024 - Jun. 2024",
    title: "Desarrollador Full Stack - DevOps",
    company: "Instituto Tecnológico TECSUP",
    description:
      "Diseñé e implementé una plataforma web para gestión de eventos deportivos en tiempo real por campeonato anual en la institución.",
    stack: [TAGS.REACT, TAGS.TAILWIND, TAGS.EXPRESS, TAGS.MONGODB]
  },
  {
    date: "Dec. 2023 - Feb. 2024",
    title: "Pasante desarrollador Full Stack",
    company: "Bitio S.R.L",
    description:
      "Implementé una aplicación de escritorio para la gestión de inventario y cotización sobre soluciones de cableado estructurado.",
    stack: [TAGS.REACT, TAGS.TAURI, TAGS.TAILWIND, TAGS.SQLITE]
  },
  {
    date: "Jul. 2023 - Ago. 2023",
    title: "DevOps y diseñador",
    company: "Sinh company",
    description:
      "Fuí parte del equipo de diseño para una plataforma de comercio electrónico, a su vez, estuve encargado del despliegue y mantenimiento de los servidores.",
    stack: [TAGS.FIGMA]
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
