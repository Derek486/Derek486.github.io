---
import CardStack from "@/components/CardStack.astro";
import { TAGS } from "@/shared/values";

const SKILLS = {
  BACKEND: [
    {
      tag: TAGS.EXPRESS,
      isImportant: true
    },
    {
      tag: TAGS.DJANGO,
      isImportant: true
    },
    {
      tag: TAGS.NODEJS,
      isImportant: true
    },
    {
      tag: TAGS.LARAVEL,
    },
    {
      tag: TAGS.SPRINGBOOT,
    },
    {
      tag: TAGS.JWT
    }
  ],
  FRONTEND: [
    {
      tag: TAGS.ANGULAR,
      isImportant: true
    },
    {
      tag: TAGS.REACT,
      isImportant: true
    },
    {
      tag: TAGS.TAILWIND,
      isImportant: true
    },
    {
      tag: TAGS.FIGMA,
    },
  ],
  DATABASE: [
    {
      tag: TAGS.MYSQL,
      isImportant: true
    },
    {
      tag: TAGS.MONGODB,
      isImportant: true
    },
    {
      tag: TAGS.SEQUELIZE,
      isImportant: true
    },
    {
      tag: TAGS.POSTGRESQL,
    },
  ],
  OTHERS: [
    {
      tag: TAGS.NGINX,
      isImportant: true
    },
    {
      tag: TAGS.DOCKER,
      isImportant: true
    },
    {
      tag: TAGS.IOT,
    },
    {
      tag: TAGS.FIGMA,
    },
  ],
}

---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <CardStack title="Backend" stack={SKILLS.BACKEND} />
  <CardStack title="Frontend" stack={SKILLS.FRONTEND} />
  <CardStack title="Database" stack={SKILLS.DATABASE} />
  <CardStack title="Others" stack={SKILLS.OTHERS} />
</div>
