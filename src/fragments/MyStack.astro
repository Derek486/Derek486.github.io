---
import CardStack from "@/components/CardStack.astro";
import { TAGS } from "@/shared/values";

const SKILLS = {
  BACKEND: [
    {
      tag: TAGS.EXPRESS,
      isImportant: true
    },
    {
      tag: TAGS.DJANGO,
      isImportant: true
    },
    {
      tag: TAGS.NODEJS,
      isImportant: true
    },
    {
      tag: TAGS.LARAVEL,
    },
    {
      tag: TAGS.SPRINGBOOT,
    },
    {
      tag: TAGS.JWT
    }
  ],
  FRONTEND: [
    {
      tag: TAGS.ANGULAR,
      isImportant: true
    },
    {
      tag: TAGS.REACT,
      isImportant: true
    },
    {
      tag: TAGS.TAILWIND,
      isImportant: true
    },
    {
      tag: TAGS.FIGMA,
    },
  ],
  DATABASE: [
    {
      tag: TAGS.MYSQL,
      isImportant: true
    },
    {
      tag: TAGS.MONGODB,
      isImportant: true
    },
    {
      tag: TAGS.SEQUELIZE,
      isImportant: true
    },
    {
      tag: TAGS.POSTGRESQL,
    },
  ],
  OTHERS: [
    {
      tag: TAGS.NGINX,
      isImportant: true
    },
    {
      tag: TAGS.DOCKER,
      isImportant: true
    },
    {
      tag: TAGS.IOT,
    },
    {
      tag: TAGS.FIGMA,
    },
  ],
}

---

<div class="grid grid-cols-3 gap-6">
  <div class="grid col-span-2 gap-6">
    <CardStack title="Backend" stack={SKILLS.BACKEND} />
    <CardStack title="Database" stack={SKILLS.FRONTEND} />
    <div class="col-span-2 row-span-2">
      <CardStack title="Others" stack={SKILLS.FRONTEND} />
    </div>
  </div>
  <div class="h-full flex">
    <CardStack title="Frontend" stack={SKILLS.FRONTEND} />
  </div>
</div>