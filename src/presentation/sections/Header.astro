---
import type { NavigationItem } from "@/domain/types/navigation-item";
import type { Profile } from "@/domain/types/profile";
import NavigationLink from "../components/NavigationLink.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import MenuIcon from "@/components/icons/Menu.astro";
import { assetUrl } from "../utils/asset-url";

interface Props { navigation: NavigationItem[]; profile: Profile }
const { navigation, profile } = Astro.props;
---

<header data-header data-scrolled="false" class="group/header pointer-events-none fixed inset-x-0 top-0 z-50 px-4 pt-3 md:px-8 md:pt-4">
  <nav aria-label="Navegación principal" class="pointer-events-auto relative mx-auto flex min-h-16 w-full max-w-6xl items-center justify-between gap-2 rounded-full border border-transparent px-2 transition-all duration-500 motion-reduce:transition-none group-data-[scrolled=true]/header:max-w-3xl group-data-[scrolled=true]/header:border-line group-data-[scrolled=true]/header:bg-canvas/85 group-data-[scrolled=true]/header:px-4 group-data-[scrolled=true]/header:shadow-[0_8px_30px_-12px_#00000030] group-data-[scrolled=true]/header:backdrop-blur-2xl max-md:border-line max-md:bg-canvas/90 max-md:px-4 max-md:backdrop-blur-xl">
    <a href="#inicio" aria-label={`${profile.shortName}, volver al inicio`} class="inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-semibold tracking-tight text-ink">
      <span aria-hidden="true" class="font-mono text-base text-accent">{"</>"}</span>
      {profile.shortName}
    </a>
    <div class="flex items-center gap-1 md:gap-2">
      <div class="hidden items-center lg:flex">
        {navigation.map((item) => <NavigationLink item={item} />)}
      </div>
      <a href={assetUrl(profile.resume)} target="_blank" rel="noopener noreferrer" class="hidden min-h-11 items-center gap-2 rounded-full bg-ink/5 px-4 text-xs font-medium text-ink transition-colors hover:bg-ink/10 sm:inline-flex">CV <span aria-hidden="true">↗</span></a>
      <ThemeToggle />
      <details data-mobile-menu class="relative lg:hidden">
        <summary aria-label="Abrir menú de navegación" class="grid size-11 cursor-pointer list-none place-items-center rounded-full text-ink transition-colors hover:bg-ink/5 [&::-webkit-details-marker]:hidden"><MenuIcon aria-hidden="true" class="size-5" /></summary>
        <div class="absolute top-14 right-0 flex min-w-56 flex-col gap-1 rounded-2xl border border-line bg-surface p-3 shadow-xl">
          {navigation.map((item) => <NavigationLink item={item} />)}
          <a href={assetUrl(profile.resume)} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-full px-3 text-sm text-muted hover:bg-ink/5">Descargar CV ↗</a>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  import { initNavigation } from "../behaviors/navigation";
  initNavigation();
</script>
