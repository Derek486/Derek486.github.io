---
import type { Profile } from "@/domain/types/profile";
import type { SiteContent } from "@/domain/types/site-content";
import Arrow from "@/components/icons/East.astro";
import LinkedIn from "@/components/icons/LinkedIn.astro";

interface Props { profile: Profile; content: SiteContent["contact"] }
const { profile, content } = Astro.props;
const linkedIn = profile.socials.find((social) => social.label === "LinkedIn");
const otherSocials = profile.socials.filter((social) => social !== linkedIn);
---

<footer id="contacto" data-nav-section aria-labelledby="contact-title" class="contact-close scroll-mt-28 border-t border-line px-6 pb-6 md:px-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 py-16 md:gap-14 md:py-24">
    <h2 id="contact-title" class="text-balance font-display text-4xl leading-[1.12] tracking-[-0.04em] text-ink md:text-5xl">
      <span class="block">{content.eyebrow}</span>
      <span class="block">{content.title}</span>
    </h2>
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-end lg:gap-16">
      <div>
        <p class="max-w-xl text-pretty text-base leading-7 text-muted">{content.description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={`mailto:${profile.email}`} class="group inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-full border border-ink bg-ink px-6 py-3 text-sm font-medium text-canvas transition-colors hover:bg-transparent hover:text-ink sm:w-auto">
            {content.action}
            <Arrow aria-hidden="true" class="size-4 shrink-0 transition-transform motion-safe:group-hover:translate-x-1" />
          </a>
          {linkedIn && (
            <a href={linkedIn.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-full border border-line px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink hover:bg-ink/10 sm:w-auto">
              <LinkedIn aria-hidden="true" />
              {linkedIn.label}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
      <div class="glass-surface min-w-0 rounded-2xl border border-line p-6 lg:w-full lg:max-w-sm lg:justify-self-end">
        <p class="mb-3 text-sm text-muted">{content.directLabel}</p>
        <a href={`mailto:${profile.email}`} class="inline-flex min-h-11 max-w-full items-center break-all text-base leading-7 text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink md:text-lg">
          {profile.email}
        </a>
      </div>
    </div>
  </div>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-line pt-5">
    <p class="text-xs leading-6 text-muted">© {new Date().getFullYear()} {profile.name}</p>
    <nav aria-label="Enlaces del pie de página" class="flex flex-wrap gap-5">
      {otherSocials.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-xs text-muted transition-colors hover:text-accent">{social.label} <span aria-hidden="true">↗</span></a>)}
      <a href="#inicio" class="inline-flex min-h-11 items-center gap-2 text-xs text-muted transition-colors hover:text-accent">Volver arriba <span aria-hidden="true">↑</span></a>
    </nav>
  </div>
</footer>

<style>
  .contact-close {
    color-scheme: dark;
    --color-canvas: #101012;
    --color-surface: #202024;
    --color-ink: #f5f5f6;
    --color-muted: #f5f5f6b8;
    --color-accent: #f5f5f6;
    --color-line: #35353b;
    --light-cast: #a1b7d9;
    color: var(--color-ink);
    background-color: var(--color-canvas);
    background-image: radial-gradient(ellipse min(45rem, 95vw) 21rem at 91% 28%, color-mix(in srgb, var(--light-cast) 13%, transparent), transparent);
  }
</style>
