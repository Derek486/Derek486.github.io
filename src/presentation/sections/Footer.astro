---
import type { Profile } from "@/domain/types/profile";
import type { SiteContent } from "@/domain/types/site-content";
import LinkedIn from "@/components/icons/LinkedIn.astro";
import GitHub from "@/components/icons/technologies/GitHub.astro";

interface Props { profile: Profile; content: SiteContent["contact"] }
const { profile, content } = Astro.props;
const socialIcons = new Map([["GitHub", GitHub], ["LinkedIn", LinkedIn]]);
---

<footer id="contacto" data-nav-section aria-labelledby="contact-title" class="scroll-mt-28 border-t border-line bg-canvas px-6 pb-6 md:px-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 py-12 md:gap-10 md:py-16">
    <div class="grid gap-4 md:grid-cols-2 md:items-center md:gap-12">
      <h2 id="contact-title" class="text-balance font-display text-3xl leading-[1.12] tracking-[-0.04em] text-ink md:text-4xl">
        <span class="block">{content.eyebrow}</span>
        <span class="block">{content.title}</span>
      </h2>
      <p class="max-w-md text-pretty text-base leading-7 text-muted">{content.description}</p>
    </div>
    <div class="grid gap-6 border-t border-line pt-6 md:grid-cols-2 md:gap-12 md:pt-8">
      <section aria-labelledby="footer-email-title" class="min-w-0">
        <h3 id="footer-email-title" class="mb-2 text-sm text-muted">{content.emailLabel}</h3>
        <address class="not-italic">
          <a href={`mailto:${profile.email}`} class="inline-flex min-h-11 max-w-full items-center wrap-anywhere text-xl text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink md:text-2xl">
            {profile.email}
          </a>
        </address>
      </section>
      <div class="grid grid-cols-[minmax(max-content,1fr)_minmax(0,1fr)] gap-x-4 lg:gap-x-8">
        <section aria-labelledby="footer-phone-title">
          <h3 id="footer-phone-title" class="mb-2 text-sm text-muted">Teléfono</h3>
          <address class="not-italic">
            <a href={`tel:${profile.phone.replaceAll(" ", "")}`} class="inline-flex min-h-11 items-center text-base text-ink tabular-nums underline decoration-line underline-offset-4 transition-colors hover:decoration-ink">
              {profile.phone}
            </a>
          </address>
        </section>
        {profile.socials.length > 0 && (
          <nav aria-labelledby="footer-social-title">
            <h3 id="footer-social-title" class="mb-2 text-sm text-muted">Redes</h3>
            <ul class="flex flex-wrap gap-x-6">
              {profile.socials.map(({ label, href }) => {
                const Icon = socialIcons.get(label);
                return (
                  <li>
                    <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-base text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink [&>svg]:size-4 [&>svg]:shrink-0">
                      {Icon && <Icon aria-hidden="true" />}
                      <span>{label}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        )}
      </div>
    </div>
  </div>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-line pt-5">
    <p class="text-xs leading-6 text-muted">© {new Date().getFullYear()} {profile.name}</p>
    <a href="#inicio" class="inline-flex min-h-11 items-center gap-2 text-xs text-muted transition-colors hover:text-accent">Volver arriba <span aria-hidden="true">↑</span></a>
  </div>
</footer>
