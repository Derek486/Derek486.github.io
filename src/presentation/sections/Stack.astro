---
import type { StackGroup } from "@/domain/types/stack-group";
import type { Technology } from "@/domain/types/technology";
import type { SiteContent } from "@/domain/types/site-content";
import SectionHeading from "../components/SectionHeading.astro";
import TechnologyList from "../components/TechnologyList.astro";

interface Props { groups: StackGroup[]; technologies: Technology[]; content: SiteContent["stack"] }
const { groups, technologies, content } = Astro.props;
---

<section id="mi-stack" class="bg-canvas px-6 py-16 md:px-10 md:py-24">
  <div class="mx-auto max-w-6xl">
    <SectionHeading {...content} />
    <div class="grid gap-x-14 gap-y-10 sm:grid-cols-2">
      {groups.map((group) => (
        <article class="border-t border-line pt-6">
          <h3 class="mb-2 text-xl font-medium tracking-tight text-ink">{group.title}</h3>
          <p class="mb-5 max-w-md text-sm leading-7 text-muted">{group.description}</p>
          <TechnologyList ids={group.technologies} technologies={technologies} />
        </article>
      ))}
    </div>
  </div>
</section>
