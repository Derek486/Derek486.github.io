---
import type { Profile } from "@/domain/types/profile";
import type { PlaygroundLayer } from "@/domain/types/playground-layer";
import type { Technology } from "@/domain/types/technology";
import ActionLink from "../components/ActionLink.astro";
import StackPlayground from "../components/StackPlayground.astro";
import { assetUrl } from "../utils/asset-url";

interface Props { profile: Profile; layers: PlaygroundLayer[]; technologies: Technology[] }
const { profile, layers, technologies } = Astro.props;
---

<section id="inicio" data-spotlight class="relative isolate overflow-hidden bg-primary px-6 pt-36 pb-16 md:px-10 md:pt-48 md:pb-24">
  <div data-spotlight-glow aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(360px_circle_at_var(--pointer-x,50%)_var(--pointer-y,50%),color-mix(in_srgb,var(--color-ink)_6%,transparent),transparent_75%)] opacity-0 transition-opacity duration-500 data-[active=true]:opacity-100 motion-reduce:hidden"></div>
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
    <div class="min-w-0">
      <p data-reveal class="mb-7 inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3 py-2 text-xs text-muted">
        <span aria-hidden="true" class="size-1.5 rounded-full bg-ink"></span>
        {profile.availability}
      </p>
      <p data-reveal class="mb-4 text-sm font-medium text-muted">{profile.introduction} <span aria-hidden="true" class="ml-1">↗</span></p>
      <h1 data-reveal class="max-w-2xl text-balance font-display text-[clamp(2.8rem,5.6vw,5rem)] leading-[1.06] font-medium tracking-[-0.055em] text-ink">
        {profile.headline}
        <span class="mt-1 block">
          <span class="relative">{profile.headlineAccent}<svg aria-hidden="true" viewBox="0 0 400 16" preserveAspectRatio="none" class="pointer-events-none absolute -bottom-3 left-0 h-4 w-full overflow-visible fill-none stroke-accent/65 stroke-2"><path pathLength="1" d="M2 12 Q170 -3 398 10" class="hero-underline [stroke-dasharray:1] motion-safe:animate-draw-line" /></svg></span>
        </span>
      </h1>
      <p data-reveal class="mt-9 max-w-md text-pretty text-base leading-8 text-muted">{profile.description}</p>
      <div data-reveal class="mt-8 flex flex-wrap gap-3">
        <ActionLink href="#proyectos">Explorar proyectos</ActionLink>
        <ActionLink href={assetUrl(profile.resume)} download variant="secondary" arrow={false}>Descargar CV <span aria-hidden="true">↓</span></ActionLink>
      </div>
      <div data-reveal class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        {profile.socials.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-xs text-muted transition-colors hover:text-accent">{social.label}<span aria-hidden="true">↗</span></a>)}
        <span class="text-xs text-muted">{profile.role}</span>
      </div>
    </div>
    <StackPlayground layers={layers} technologies={technologies} />
  </div>
  <div data-reveal class="mx-auto mt-14 flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-line pt-6 md:mt-20">
    <p class="text-xs text-muted">{profile.focus}</p>
    <a href="#proyectos" class="inline-flex min-h-11 items-center gap-3 text-xs text-muted transition-colors hover:text-accent">Un poco de mi trabajo <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  :global([data-portfolio-entry]) .hero-underline {
    animation-play-state: paused;
  }
</style>

<script>
  import { initSpotlight } from "../behaviors/spotlight";
  initSpotlight();
</script>
