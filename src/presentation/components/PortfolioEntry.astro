---
import Code from "@/components/icons/Code.astro";
---

<div id="portfolio-entry" class="entry" aria-hidden="true" hidden>
  <div data-entry-panel class="panel panel-left"></div>
  <div class="panel panel-right"></div>
  <div data-entry-halo class="halo"></div>
  <Code class="mark" />
</div>

<script is:inline>
  (() => {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    if (motion.matches || location.hash || performance.getEntriesByType("navigation")[0]?.type === "back_forward") return;

    try {
      if (sessionStorage.getItem("portfolio-entry-seen")) return;
      sessionStorage.setItem("portfolio-entry-seen", "1");
    } catch {
      // The intro can still finish normally when storage is unavailable.
    }

    const root = document.documentElement;
    const entry = document.getElementById("portfolio-entry");
    const panel = entry.querySelector("[data-entry-panel]");
    const controller = new AbortController();
    const { signal } = controller;

    function reveal() {
      if (!root.hasAttribute("data-portfolio-entry")) return;
      root.removeAttribute("data-portfolio-entry");
      document.dispatchEvent(new Event("portfolio:entry-reveal"));
    }

    function finish() {
      controller.abort();
      clearTimeout(fallback);
      reveal();
      entry.hidden = true;
    }

    panel.addEventListener("animationstart", reveal, { signal });
    panel.addEventListener("animationend", finish, { signal });
    panel.addEventListener("animationcancel", finish, { signal });
    motion.addEventListener("change", finish, { signal });
    document.addEventListener("focusin", finish, { signal, once: true });
    window.addEventListener("scroll", finish, { signal, passive: true });
    window.addEventListener("hashchange", finish, { signal });
    window.addEventListener("pagehide", finish, { signal });

    // Fail open if the CSS animation is unavailable or does not dispatch events.
    const fallback = setTimeout(finish, 1600);
    root.setAttribute("data-portfolio-entry", "");
    entry.hidden = false;
  })();
</script>

<style>
  .entry {
    --open-at: 760ms;
    --open-duration: 520ms;
    --open-ease: cubic-bezier(0.76, 0, 0.24, 1);
    position: fixed;
    inset: 0;
    z-index: 110;
    display: grid;
    place-items: center;
    overflow: clip;
    color: var(--color-ink);
    pointer-events: none;
  }

  .entry[hidden] { display: none; }

  :global([data-portfolio-entry]) .entry { pointer-events: auto; }

  .panel {
    position: absolute;
    inset-block: 0;
    width: calc(50% + 1px);
    background: var(--color-primary);
    animation: open-panel var(--open-duration) var(--open-ease) var(--open-at) both;
  }

  .panel-left { left: 0; --exit-x: -101%; }
  .panel-right { right: 0; --exit-x: 101%; }

  :global(:root:not([data-portfolio-entry])) .panel-left { border-right: 1px solid var(--color-line); }
  :global(:root:not([data-portfolio-entry])) .panel-right { border-left: 1px solid var(--color-line); }

  .halo {
    position: absolute;
    width: clamp(11rem, 34vw, 22rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--light-cast) 25%, transparent);
    background: radial-gradient(circle, color-mix(in srgb, var(--light-cast) 16%, transparent), transparent 70%);
    box-shadow: 0 0 3rem color-mix(in srgb, var(--light-cast) 14%, transparent);
    animation: expand-halo calc(var(--open-at) + 260ms) cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .mark {
    position: relative;
    width: clamp(5rem, 16vw, 8.75rem);
    height: auto;
    stroke-width: 1.35;
    animation: exit-mark 220ms ease-in var(--open-at) both;
  }

  .mark :global(path) {
    stroke-dasharray: 1;
    animation: draw-mark 390ms cubic-bezier(0.2, 0, 0.2, 1) both;
  }

  .mark :global(path:nth-child(2)) { animation-delay: 100ms; }
  .mark :global(path:nth-child(3)) { animation-delay: 180ms; }

  @keyframes draw-mark {
    from { stroke-dashoffset: 1; opacity: 0; }
    20%, to { opacity: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes exit-mark {
    to { opacity: 0; }
  }

  @keyframes expand-halo {
    from { transform: scale(0.52); opacity: 0; }
    34% { opacity: 0.85; }
    to { transform: scale(1.85); opacity: 0; }
  }

  @keyframes open-panel {
    from { transform: translateX(0); }
    to { transform: translateX(var(--exit-x)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry { display: none; }
  }
</style>
