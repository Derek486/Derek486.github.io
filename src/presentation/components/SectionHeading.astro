---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div data-reveal class="mb-10 md:mb-14">
  <p class="mb-4 text-sm font-medium text-accent">{eyebrow}</p>
  <h2 class="text-balance font-display text-4xl leading-[1.12] tracking-[-0.04em] text-ink md:text-5xl">{title}</h2>
  {description && <p class="mt-5 max-w-xl text-pretty text-base leading-7 text-muted">{description}</p>}
</div>
