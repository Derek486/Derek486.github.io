---
import type { Project } from "@/domain/types/project";
import type { Technology } from "@/domain/types/technology";
import ActionLink from "./ActionLink.astro";
import ProjectCover from "./ProjectCover.astro";
import TechnologyList from "./TechnologyList.astro";
import { projectAnchor, projectUrl } from "../utils/project-url";

interface Props {
  project: Project;
  technologies: Technology[];
  coverSide?: "left" | "right";
}
const { project, technologies, coverSide } = Astro.props;
---

<article
  id={projectAnchor(project.id)}
  data-project={project.id}
  class:list={[
    "glass-surface min-w-0 scroll-mt-28 rounded-2xl border border-line p-4 lg:p-5",
    coverSide
      ? "md:grid md:grid-cols-2 md:items-center md:gap-8 lg:gap-12"
      : "flex flex-col [--glass-card-depth:var(--card-shadow-soft)]",
  ]}
>
  <a
    href={projectUrl(project.id)}
    aria-label={`Ver proyecto: ${project.title}`}
    class:list={[
      "group/cover mb-5 block min-w-0",
      coverSide && "md:row-start-1 md:mb-0",
      coverSide === "right" ? "md:col-start-2" : coverSide && "md:col-start-1",
    ]}
  >
    <ProjectCover project={project} />
    <span aria-hidden="true" class="mt-3 flex items-center justify-end gap-2 text-sm font-medium text-ink decoration-muted underline-offset-4 group-hover/cover:underline">
      Ver proyecto <span class="text-base leading-none motion-safe:transition-transform motion-safe:group-hover/cover:translate-x-0.5">→</span>
    </span>
  </a>
  <div
    data-reveal="project-details"
    class:list={[
      "flex min-w-0 flex-col gap-5",
      coverSide ? "md:row-start-1" : "grow justify-between",
      coverSide === "left" ? "md:col-start-2" : coverSide && "md:col-start-1",
    ]}
  >
    <div class="max-w-2xl">
      <p class="mb-2 text-xs text-muted">{project.category}</p>
      <h3 class="mb-3 text-2xl font-semibold tracking-tight text-ink">{project.title}</h3>
      <p class="mb-5 text-sm leading-7 text-muted">{project.description}</p>
      {project.highlights && project.highlights.length > 0 && (
        <ul aria-label={`Aspectos destacados de ${project.title}`} class="mb-6 list-disc space-y-2 pl-4 text-sm leading-7 text-muted marker:text-ink">
          {project.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      )}
      <TechnologyList ids={project.technologies} technologies={technologies} emphasis={project.keyTechnologies} />
    </div>
    <div class="flex shrink-0 flex-wrap gap-2">
      <ActionLink href={project.github} target="_blank" variant="secondary">Ver código</ActionLink>
      {project.link && <ActionLink href={project.link} target="_blank">Ver demo</ActionLink>}
    </div>
  </div>
</article>
