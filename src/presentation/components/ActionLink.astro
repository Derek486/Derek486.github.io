---
import type { HTMLAttributes } from "astro/types";
import Arrow from "@/components/icons/East.astro";

interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "secondary";
  arrow?: boolean;
}

const { variant = "primary", arrow = true, class: className, ...attributes } = Astro.props;
---

<a
  {...attributes}
  rel={attributes.target === "_blank" ? "noopener noreferrer" : attributes.rel}
  class:list={[
    "group inline-flex min-h-12 items-center justify-center gap-3 rounded-full border px-6 py-3 text-sm font-medium transition duration-300 motion-safe:hover:-translate-y-0.5",
    variant === "primary"
      ? "border-ink bg-ink text-canvas hover:bg-transparent hover:text-ink"
      : "border-line bg-transparent text-ink hover:border-ink hover:bg-surface",
    className,
  ]}
>
  <slot />
  {arrow && <Arrow aria-hidden="true" class="size-4 transition-transform duration-300 motion-safe:group-hover:translate-x-1" />}
</a>
