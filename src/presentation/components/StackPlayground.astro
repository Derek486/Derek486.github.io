---
import type { PlaygroundLayer } from "@/domain/types/playground-layer";
import type { Technology } from "@/domain/types/technology";
import TechnologyList from "./TechnologyList.astro";

interface Props {
  layers: PlaygroundLayer[];
  technologies: Technology[];
}
const { layers, technologies } = Astro.props;
---

<div data-playground data-reveal class="relative mx-auto w-full min-w-0 max-w-md lg:ml-auto">
  <div class="glass-card glass-surface rounded-2xl border border-line">
    <h2 class="px-6 pt-6 text-base font-semibold text-ink">Qué puedo aportar</h2>
    <div data-layer-controls class="layer-rail mx-6 mt-5 grid grid-cols-3 gap-1 rounded-full border border-line p-1" role="group" aria-label="Explorar capacidades de desarrollo full stack">
      {layers.map((layer, index) => (
        <button
          type="button"
          data-layer-button={layer.id}
          aria-pressed={index === 0 ? "true" : "false"}
          aria-controls={`layer-${layer.id}`}
          class="min-h-11 min-w-0 cursor-pointer rounded-full px-1 text-sm font-medium wrap-anywhere text-muted transition-colors hover:bg-ink/5 aria-pressed:bg-accent aria-pressed:text-canvas forced-colors:aria-pressed:outline"
        >{layer.label}</button>
      ))}
    </div>
    {layers.map((layer, index) => (
      <div id={`layer-${layer.id}`} data-layer-panel={layer.id} hidden={index !== 0} class="p-6">
        <h3 class="mb-3 text-xl font-medium leading-snug tracking-tight text-ink">{layer.title}</h3>
        <p class="mb-5 text-sm leading-7 text-muted">{layer.description}</p>
        <TechnologyList ids={layer.technologies} technologies={technologies} emphasis={layer.keyTechnologies} />
        <div class="mt-6 border-t border-line pt-5">
          <p class="text-sm leading-7 text-muted">{layer.example}</p>
          <a href={`#experiencia-${layer.experienceId}`} class="mt-3 inline-flex min-h-11 items-center text-sm font-medium text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent">Ver experiencia relacionada</a>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .layer-rail {
    background-color: color-mix(in srgb, var(--color-ink) 4%, transparent);
    box-shadow: inset 0 1px 3px color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
</style>

<script>
  import { initPlayground } from "../behaviors/playground";
  initPlayground();
</script>
