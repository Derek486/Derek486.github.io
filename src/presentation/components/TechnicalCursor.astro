<style>
  [data-technical-cursor] {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 120;
    width: 2.5rem;
    height: 2.5rem;
    color: white;
    mix-blend-mode: difference;
    pointer-events: none;
    visibility: hidden;
    transform: translate3d(var(--cursor-x, 0px), var(--cursor-y, 0px), 0) translate(-50%, -50%);
  }

  @media (any-hover: hover) and (any-pointer: fine) and (prefers-reduced-motion: no-preference) and (forced-colors: none) {
