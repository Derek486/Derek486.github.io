---
import Layout from "@/layouts/Layout.astro";
import { getPortfolio } from "@/application/get-portfolio";
import { jsonPortfolioRepository } from "@/infrastructure/repositories/json-portfolio-repository";
import PortfolioEntry from "@/presentation/components/PortfolioEntry.astro";
import Header from "@/presentation/sections/Header.astro";
import Hero from "@/presentation/sections/Hero.astro";
import Projects from "@/presentation/sections/Projects.astro";
import Stack from "@/presentation/sections/Stack.astro";
import Experience from "@/presentation/sections/Experience.astro";
import About from "@/presentation/sections/About.astro";
import Footer from "@/presentation/sections/Footer.astro";

const { profile, content, navigation, projects, experiences, technologies, stack, playground } =
  getPortfolio(jsonPortfolioRepository);
---

<Layout title={content.title} description={content.description}>
  <PortfolioEntry slot="entry" />
  <Header navigation={navigation} profile={profile} />
  <main id="contenido" tabindex="-1" class="outline-none">
    <Hero profile={profile} layers={playground} technologies={technologies} />
    <Projects projects={projects} technologies={technologies} content={content.projects} />
    <Stack groups={stack} technologies={technologies} content={content.stack} />
    <Experience experiences={experiences} technologies={technologies} content={content.experience} />
    <About profile={profile} content={content.about} />
  </main>
  <Footer profile={profile} content={content.contact} />
</Layout>
