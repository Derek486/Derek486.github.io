---
import Layout from "@/layouts/Layout.astro";
import BriefcaseIcon from "@/components/icons/Briefcase.astro";
import CodeIcon from "@/components/icons/Code.astro";
import Experience from "@/fragments/Experience.astro";
import ProfileCheckIcon from "@/components/icons/ProfileCheck.astro";
import Projects from "@/fragments/Projects.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Hero from "@/fragments/Hero.astro";
import TitleSection from "@/components/TitleSection.astro";
import AboutMe from "@/fragments/AboutMe.astro";
import MyStack from "@/fragments/MyStack.astro";
import ConstructionIcon from "@/components/icons/Construction.astro";
---

<Layout
  title="Porfolio de Derek486 - Desarrollador y Programador Web Full Stack"
  description="Desarrollador Web, móvil y de escritorio apasionado por la tecnología."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer id="experiencia">
        <TitleSection>
          <BriefcaseIcon class="size-8" />
          Experiencia laboral
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <TitleSection>
          <CodeIcon class="size-7" />
          Proyectos
        </TitleSection>
        <Projects />
      </SectionContainer>

      <SectionContainer id="mi-stack">
        <TitleSection>
          <ConstructionIcon class="size-7" />
          Mi stack
        </TitleSection>
        <MyStack />
      </SectionContainer>
  
      <SectionContainer id="sobre-mi">
        <TitleSection>
          <ProfileCheckIcon class="size-8" />
          Sobre mí
        </TitleSection>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>
