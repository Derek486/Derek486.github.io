---
import MenuIcon from "./icons/Menu.astro"
import EastIcon from "./icons/East.astro"

const navItems = [
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "mailto:juanjosecondoripinto@gmail.com",
  },
];
---

<div class="relative mx-1">
  <button
    transition:persist
    id="menu-toggle-btn"
    class="appearance-none border-none flex hover:scale-125 transition"
  >
    <span class="sr-only">Menu</span>
    <MenuIcon class="menu-toggle-icon size-5 transition-all" />
  </button>
  <div
    transition:persist
    id="header-menu"
    class="absolute hidden scale-80 top-8 right-0 text-sm p-1 min-w-[10rem] rounded-md border border-gray-100 bg-white/90 dark:bg-gray-900/90 dark:border-gray-500/20 shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md"
  >
    <div class="flex flex-col gap-2">
      {
        navItems.map((link) => (
          <a
            class="flex justify-between px-2 py-1.5 transition hover:text-blue-500 dark:hover:text-blue-500 group"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
            <span class="hidden group-hover:block">
              <EastIcon />
            </span>
          </a>   
        ))
      }
    </div>
  </div>
</div>

<style>
  #header-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  const menu = document.getElementById("header-menu")

  document.addEventListener("click", () => menu.classList.remove("open"))

  document.getElementById("menu-toggle-btn").addEventListener("click", (e) => {
    e.stopPropagation()
    const isClosed = !menu.classList.contains("open")
    menu.classList[isClosed ? "add" : "remove"]("open")
  })

  document.querySelectorAll(".header-menu-option").forEach((element) => {
    element.addEventListener("click", (e) => {
      localStorage.setItem("menu", e.target.innerText.toLowerCase().trim())
      updateTheme()
    })
  })

  document.addEventListener('astro:after-swap', () => {
    updateTheme();
    window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
  })
</script>
