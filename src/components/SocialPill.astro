---
interface Props{
  isFill?: boolean
  href: string
}

const { isFill, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  role="link"
  class="inline-flex items-center justify-center gap-2 px-4 py-1 transition border rounded-md text-md group max-w-fit focus:outline-none focus-visible:outline-none"
  class:list={{
    "text-gray-800 bg-gray-100 border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:text-white": !isFill,
    "bg-gray-800 border-gray-700 text-white dark:bg-gray-200 dark:border-gray-300 dark:text-black": isFill,
    "hover:bg-gray-900 hover:border-gray-700 hover:text-white dark:hover:bg-gray-100 dark:hover:border-gray-300 dark:hover:text-black": true,
    "focus-visible:ring focus-visible:ring-yellow-500/80 focus-visible:ring-offset-2": true,
  }}
>
  <slot />
</a>
