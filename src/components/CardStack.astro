---
import type { ITagIcon } from "@/shared/types";
import PillTech from "./PillTech.astro";

interface Props {
  title: string;
  stack: { tag: ITagIcon; isImportant?: boolean }[];
}

const { title, stack } = Astro.props;
---

<section class="flex flex-col gap-2 p-4 border border-neutral-800 rounded-lg hover:border-neutral-700 transition-colors">
  <h2 class="text-neutral-300 text-sm font-semibold uppercase tracking-wide">
    {title}
  </h2>
  <div class="flex flex-wrap gap-2">
    {stack.map((tech) => (
      <PillTech tag={tech.tag} isImportant={tech.isImportant ?? false} />
    ))}
  </div>
</section>
