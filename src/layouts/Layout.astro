---
import "@fontsource-variable/onest";
import "@fontsource-variable/fraunces";
import "@/styles/global.css";

interface Props { title: string; description: string }
const { description, title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-canvas font-sans text-ink antialiased [color-scheme:light] motion-reduce:scroll-auto dark:[color-scheme:dark]">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        document.documentElement.classList.toggle("dark", localStorage.getItem("theme") === "dark");
      } catch {
        // Light theme is the default, even without persistent storage.
      }
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <a href="#contenido" class="fixed top-3 left-4 z-[100] -translate-y-24 rounded-full bg-ink px-5 py-3 text-sm text-canvas focus:translate-y-0">Saltar al contenido</a>
    <slot />
    <script>
      import { initReveals } from "@/presentation/behaviors/reveal";
      initReveals();
    </script>
  </body>
</html>
